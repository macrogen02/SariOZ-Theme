<section class="newsletter section-padding" aria-labelledby="newsletter-heading">
  <div class="page-width newsletter__inner">
    <h2 id="newsletter-heading">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail">Email address</label>
      <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Enter your email" required>
      <button class="button button--gold" type="submit">{{ section.settings.button_label }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the SARIOZ community"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get product updates, community stories, and launches from AU to PH."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [{"name": "Newsletter"}]
}
{% endschema %}
